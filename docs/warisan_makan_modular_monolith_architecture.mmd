%%{init: {"theme":"base", "themeVariables": {"fontFamily":"Arial", "fontSize":"14px", "lineColor":"#4b5563", "primaryTextColor":"#111827"}, "flowchart": {"curve":"linear", "nodeSpacing":34, "rankSpacing":44}}}%%
flowchart LR
    subgraph SYSTEM["WARISAN MAKAN — Modular Monolith Architecture using Laravel MVC with Service Layer\nCulinary Heritage Tourism System"]
        direction LR

        subgraph CLIENT["Client Access\nPurpose: Provides the interface for guests, registered users, and administrators to access the system through web or mobile browsers."]
            direction TB
            ACTORS["Guest\nRegistered User\nSystem Administrator"]:::actor
            BROWSER["Web / Mobile Browser\nHTML • JavaScript • PWA-style interface"]:::browser
            GEO["Browser Geolocation API\nFood passport check-in\nFood trail location / navigation"]:::browser
            ACTORS --> BROWSER
            GEO -. "latitude / longitude when required" .-> BROWSER
            CNOTE["• Responsive public, user, and admin interfaces\n• Browser sends requests through HTTP / HTTPS\n• No separate client server is required"]:::note
        end

        subgraph APP["Laravel Application\nONE application boundary — Modular Monolith"]
            direction TB
            APPNOTE["Purpose: Processes business logic, validates requests, coordinates MVC components, and provides secure shared application services."]:::note

            subgraph MODULES["Logical Functional Modules"]
                direction LR
                UM["User Management"]:::module
                HS["Heritage Shop Tracking\nCENTRAL HERITAGE CONTENT SOURCE"]:::central
                FP["Food Passport &\nAchievement"]:::module
                FT["Food Trail &\nNavigation"]:::module
                CC["Community Contribution &\nVendor Submission"]:::module
                BB["Blind Box\nRecommendation"]:::module
            end

            UM -->|"Authentication / User Identity / Authorization"| FP
            UM -->|"Authentication / User Identity / Authorization"| FT
            UM -->|"Authentication / User Identity / Authorization"| CC
            UM -->|"Authentication / User Identity / Authorization"| BB
            HS -->|"Heritage Shop + Location Data"| FP
            HS -->|"Heritage Shop + Location Data"| FT
            HS -->|"Existing Heritage Shop Data"| CC
            HS -->|"Published Heritage Shop Data"| BB
            CC -->|"Approved Contribution / Approved Correction"| HS

            subgraph FLOW["Shared Laravel Request Flow"]
                direction LR
                ROUTES["Laravel Routes\nroutes/web.php"]:::request
                MIDDLE["Middleware / Access Control\nguest • auth • active_user\nadmin • throttle"]:::request
                VALIDATE["Form Requests\nValidation / Authorization"]:::request
                ROUTES --> MIDDLE --> VALIDATE
            end

            subgraph MVC["Laravel MVC and Selected Service Layer"]
                direction LR
                CONTROLLER["CONTROLLER (C)\nReceives routed requests\nCoordinates use cases\nAuthorization / validated handling\nReturns views, redirects, or JSON"]:::controller
                VIEW["VIEW (V)\nBlade Templates: resources/views\nJavaScript • Vite\nPublic • Registered User • Administrator Interfaces"]:::view
                SERVICE["SERVICE LAYER\nBusiness / Integration Logic\nShopCrawlerService\nHeritageShopAiGuideService\nHeritageShopImageService\nHeritageShopUrlGuard\nHeritageShopCatalog\nBlindBoxCatalogManager"]:::service
                MODEL["MODEL (M)\nLaravel Eloquent ORM / Domain Models\nUser • HeritageShop • HeritageFoodItem\nShopImage • PassportStamp • Badge • UserBadge\nFoodTrailSuggestion • Contribution • CorrectionRequest\nBlindBoxDraw"]:::model
                FLOW --> CONTROLLER
                CONTROLLER -->|"Render Blade View / Response"| VIEW
                VIEW -->|"User Action / New HTTP Request"| CONTROLLER
                CONTROLLER -->|"Business / Integration Operation"| SERVICE
                SERVICE -->|"Read / Update Domain Data"| MODEL
                CONTROLLER -.->|"Direct Eloquent Access"| MODEL
                CONTROLLER -->|"Browser / User Request"| MODEL
                MODEL -->|"Domain Data / Result"| CONTROLLER
            end

            subgraph CONTROLLERS["Representative Controllers"]
                direction LR
                USERCTL["AuthController\nProfileController\nHeritageShopController\nPassportController\nFoodTrailController"]:::controllerSmall
                COMMUNITYCTL["CommunityContributionController\nCorrectionRequestController\nBlindBoxController\nChatController"]:::controllerSmall
                ADMINCTL["UserManagementController\nHeritageShopAdminController\nHeritageFoodItemAdminController\nAdminCommunityContributionController\nFoodTrailSuggestionController\nBadgeManagementController\nAdmin BlindBoxController"]:::controllerSmall
            end
            CONTROLLER -. "includes" .-> USERCTL
            CONTROLLER -. "includes" .-> COMMUNITYCTL
            CONTROLLER -. "includes" .-> ADMINCTL

            subgraph INFRA["Shared Laravel Infrastructure"]
                direction LR
                INFRA1["Authentication\nSession Management\nAuthorization / Roles"]:::infra
                INFRA2["CSRF Protection\nValidation\nLaravel Notifications"]:::infra
                INFRA3["Cache\nQueue Infrastructure\nMedia / File Handling"]:::infra
            end
            CONTROLLER -.-> INFRA
            SERVICE -.-> INFRA

            APPRESP["• All six modules run inside the same Laravel application\n• Controllers can call Services or directly use Eloquent Models\n• Shared infrastructure is not a separate functional module\n• No API Gateway, message broker, Kubernetes, or microservices"]:::note
        end

        subgraph RIGHT["Shared Data, Media, and External Integrations"]
            direction TB
            RIGHTNOTE["Purpose: Provides shared persistence, media storage, maps, authentication, AI, web research, and email capabilities while remaining outside the Laravel application boundary."]:::note
            subgraph EXTERNAL["External Services"]
                direction LR
                OAUTH["Google OAuth\nLaravel Socialite"]:::external
                MAPS["Google Maps JavaScript API\nFood Trail Map / Navigation"]:::external
                GROQ["Groq API\nAI Guide • crawler enhancement\nChat Assistant"]:::external
                TAVILY["Tavily Search API\nCrawler Web Research"]:::external
                MAIL["Mail Service / Laravel Mail Transport\nEmail Notifications"]:::external
            end
            subgraph STORAGE["Shared Persistence and Storage"]
                direction LR
                DB["MySQL Database\nShared Warisan Makan Relational Database\nAll six modules share one database"]:::data
                FILES["File / Object Storage\nCloudflare R2 — deployed media\nLaravel Local / Public Storage — development / testing"]:::data
            end
        end

        BROWSER -->|"HTTP / HTTPS"| ROUTES
        VIEW -->|"Rendered interface"| BROWSER
        CONTROLLER -. "AuthController ↔" .-> OAUTH
        VIEW -. "Food Trail JavaScript ↔" .-> MAPS
        SERVICE -. "AI / Service / Chat logic ↔" .-> GROQ
        SERVICE -. "ShopCrawlerService ↔" .-> TAVILY
        CC -. "Contribution status notifications" .-> MAIL
        MODEL -->|"Eloquent / SQL"| DB
        SERVICE -. "HeritageShopImageService / contribution media" .-> FILES
    end


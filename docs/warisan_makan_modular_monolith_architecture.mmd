%%{init: {"theme":"base", "themeVariables": {"fontFamily":"Arial", "fontSize":"15px", "lineColor":"#475569", "primaryTextColor":"#0f172a"}, "flowchart": {"curve":"basis", "nodeSpacing":45, "rankSpacing":60}}}%%
flowchart LR
    TITLE["WARISAN MAKAN<br/>Modular Monolith Architecture using Laravel MVC with Service Layer<br/><i>Culinary Heritage Tourism System</i>"]:::title
    TITLE ~~~ APP

    %% LEFT: actors and browser
    subgraph ACTORS["Actors / Client Access"]
        direction TB
        G["Guest"]:::actor
        U["Registered User"]:::actor
        A["System Administrator"]:::actor
        B["Web / Mobile Browser<br/>HTML • JavaScript • PWA-style interface"]:::browser
        GEO["Browser Geolocation API<br/>check-in • trail location"]:::browser
        G --> B
        U --> B
        A --> B
        GEO -. "latitude / longitude when required" .-> B
    end

    B -->|HTTP / HTTPS| APP

    %% CENTER: single Laravel modular monolith boundary
    subgraph APP["WARISAN MAKAN\nLaravel Application — Modular Monolith"]
        direction TB

        subgraph MODULES["Logical Functional Modules"]
            direction LR
            UM["User Management"]:::module
            HS["Heritage Shop Tracking\nCENTRAL HERITAGE CONTENT SOURCE"]:::central
            FP["Food Passport & Achievement"]:::module
            FT["Food Trail & Navigation"]:::module
            CC["Community Contribution &\nVendor Submission"]:::module
            BB["Blind Box Recommendation"]:::module
        end

        UM -->|"Authentication / User Identity / Authorization"| FP
        UM -->|"Authentication / User Identity / Authorization"| FT
        UM -->|"Authentication / User Identity / Authorization"| CC
        UM -->|"Authentication / User Identity / Authorization"| BB
        HS -->|"Heritage Shop + Location Data"| FP
        HS -->|"Heritage Shop + Location Data"| FT
        HS -->|"Existing Heritage Shop Data"| CC
        HS -->|"Published Heritage Shop Data"| BB
        CC -->|"Approved Contribution / Approved Correction"| HS

        subgraph REQUEST["Shared Laravel Request Processing"]
            direction TB
            R["Laravel Routes\nroutes/web.php"]:::request
            MW["Middleware / Access Control\nguest • auth • active_user • admin • throttle"]:::request
            VLD["Form Requests / Validation / Authorization"]:::request
            C["CONTROLLER (C)\nReceives requests • coordinates use cases\nauthorizes • validates • returns views / redirects / JSON"]:::controller
            R --> MW --> VLD --> C
        end

        subgraph MVC["Laravel MVC + Selected Service Layer"]
            direction LR
            V["VIEW (V) — Presentation Layer\nBlade Templates: resources/views\nJavaScript • Vite\nPublic / Registered User / Administrator Interfaces"]:::view
            S["SERVICE LAYER\nBusiness / Integration Logic\nShopCrawlerService\nHeritageShopAiGuideService\nHeritageShopImageService\nHeritageShopUrlGuard\nHeritageShopCatalog\nBlindBoxCatalogManager"]:::service
            M["MODEL (M)\nLaravel Eloquent ORM / Domain Models\nUser • HeritageShop • HeritageFoodItem • ShopImage\nPassportStamp • Badge • UserBadge • FoodTrailSuggestion\nHeritageShopContribution • CorrectionRequest • BlindBoxDraw"]:::model
        end

        C -->|"Render Blade View / Response"| V
        V -->|"User Action / HTTP Request"| C
        C -->|"Business / Integration Operation"| S
        S -->|"Read / Update Domain Data"| M
        C -.->|"Direct Eloquent Access"| M
        C -->|"Browser / User Request"| M
        M -->|"Domain Data / Result"| C
        C -->|"Response"| V

        subgraph INFRA["Shared Laravel Infrastructure"]
            direction LR
            I1["Authentication"]:::infra
            I2["Session Management"]:::infra
            I3["Authorization / Roles"]:::infra
            I4["CSRF Protection"]:::infra
            I5["Validation"]:::infra
            I6["Laravel Notifications"]:::infra
            I7["Cache"]:::infra
            I8["Queue Infrastructure"]:::infra
            I9["Media / File Handling"]:::infra
        end

        C -.-> INFRA
        S -.-> INFRA

        subgraph EXAMPLES["Representative Controller Components"]
            direction LR
            CTL1["AuthController • ProfileController\nHeritageShopController • PassportController\nFoodTrailController • CommunityContributionController\nCorrectionRequestController • BlindBoxController • ChatController"]:::controllerSmall
            CTL2["Administrator Controllers\nUserManagementController • HeritageShopAdminController\nHeritageFoodItemAdminController • AdminCommunityContributionController\nFoodTrailSuggestionController • BadgeManagementController\nAdmin BlindBoxController"]:::controllerSmall
        end
        C -. "includes" .-> EXAMPLES
    end

    %% RIGHT: external integrations
    subgraph EXT["External Services / Integrations"]
        direction TB
        OAUTH["Google OAuth\nAuthentication through Laravel Socialite"]:::external
        MAPS["Google Maps JavaScript API\nFood Trail Map / Navigation / Location Display"]:::external
        GROQ["Groq API\nAI Processing\nAI Guide • crawler enhancement • chat assistant"]:::external
        TAVILY["Tavily Search API\nCrawler Web Research"]:::external
        MAIL["Mail Service / Laravel Mail Transport\nEmail Notifications"]:::external
    end

    APP -. "AuthController ↔" .-> OAUTH
    V -. "Food Trail View / JavaScript ↔" .-> MAPS
    S -. "AI / Service / Chat logic ↔" .-> GROQ
    S -. "ShopCrawlerService ↔" .-> TAVILY
    CC -. "status notifications" .-> MAIL

    %% BOTTOM RIGHT: shared persistence and storage
    subgraph DATA["Shared Persistence and Media"]
        direction TB
        DB["MySQL Database\nShared Warisan Makan Relational Database\nAll six modules share one database"]:::data
        FS["File / Object Storage\nCloudflare R2 — deployed heritage shop / media storage\nLaravel Local / Public Storage — development / testing"]:::data
    end

    M -->|"Eloquent / SQL"| DB
    S -. "HeritageShopImageService / contribution media" .-> FS

    %% return to browser
    V -->|"Rendered interface"| B

